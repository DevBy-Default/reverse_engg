# ==============================================================================
# REA (Reverse Engineer Anything) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or export these variables in your shell / agent environment.
# All paths must be absolute paths according to your operating system.
# ==============================================================================

# --- Analysis Provider Selection ---
# Preferred provider: 'auto', 'ghidra', 'ida', 'hopper', 'cutter', 'rizin', 'jeb'
REA_ANALYSIS_PROVIDER=auto

# --- Logging & Diagnostics ---
# Log level: 'trace', 'debug', 'info', 'warn', 'error', 'fatal', 'silent'
REA_LOG_LEVEL=info

# --- Ghidra Provider Configuration ---
# Absolute path to your local Ghidra installation directory
# GHIDRA_INSTALL_DIR=/opt/ghidra or C:\Tools\ghidra_11.2_PUBLIC
# GHIDRA_INSTALL_DIR=

# Absolute path to JDK 17+ / 21+ for Ghidra runtime
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk or C:\Program Files\Eclipse Adoptium\jdk-21.0.2.13-hotspot
# JAVA_HOME=

# Ghidra headless startup timeout in milliseconds (default: 120000)
REA_GHIDRA_STARTUP_TIMEOUT_MS=120000

# Optional custom Ghidra NativeAOT analyzer JAR path
# REA_GHIDRA_NATIVEAOT_JAR=/path/to/ReaGhidraNativeAot.jar

# Optional architecture and compiler specification overrides
# REA_GHIDRA_LANGUAGE_ID=x86:LE:64:default
# REA_GHIDRA_COMPILER_SPEC_ID=gcc

# Optional disabled Ghidra analyzers (comma-separated or JSON array)
# REA_GHIDRA_DISABLED_ANALYZERS=Decompiler Parameter ID,ASCII Strings

# Optional address/symbol seeds file (absolute path to JSON)
# REA_GHIDRA_SEED_FILE=/path/to/seeds.json

# --- Hopper Provider Configuration ---
# Hopper launcher path and startup timeout
# HOPPER_LAUNCHER_PATH=/Applications/Hopper Disassembler v4.app/Contents/MacOS/hopper
REA_HOPPER_STARTUP_TIMEOUT_MS=60000

# --- IDA Pro MCP Configuration ---
# Absolute path to IDA MCP server configuration
# REA_IDA_MCP_CONFIG=/path/to/ida-mcp-config.json

# --- .NET Analysis (ILCompiler / ILSpy) ---
# Absolute path to ilspycmd binary
# REA_ILSPY_CMD_PATH=/usr/local/bin/ilspycmd

# --- MCP Response & Schema Profiles ---
# Maximum bytes allocated per MCP response envelope
# REA_MCP_MAX_RESPONSE_BYTES=1048576

# MCP schema profiles: standard, compact, full
# REA_MCP_INPUT_SCHEMA_PROFILE=standard
# REA_MCP_OUTPUT_SCHEMA_PROFILE=standard

# --- Privacy & Evidence Redaction ---
# JSON array of regex patterns to redact sensitive tokens from Evidence records
REA_REFERENCE_SECRET_PATTERNS_JSON=[]
